# Optional local overrides.
# Nonempty provider endpoints and API keys override saved Settings values.
# Environment-controlled endpoint fields are disabled in the UI.
# Remove an endpoint value and restart to manage it through Settings.
# Leave values unset to keep the current defaults.

# Backend API port. Defaults to 3000.
EULER_BACKEND_PORT=3000

# Backend bind host. Defaults to 127.0.0.1 for local runs.
EULER_BACKEND_HOST=127.0.0.1

# Starting folder and ~ expansion for the directory picker.
# Defaults to your HOME. Set explicitly when running under a service account.
# EULER_HOST_DIRECTORY=/home/your-user

# Vite frontend port for dev. Defaults to 5174.
EULER_FRONTEND_PORT=5174

# Ollama endpoint. Defaults to ollama-js local behavior.
EULER_OLLAMA_HOST=http://127.0.0.1:11434

# ComfyUI endpoint. Defaults to http://127.0.0.1:8188.
EULER_COMFYUI_HOST=http://127.0.0.1:8188

# Brave Search API key for the web_search tool. Can also be set in Settings.
BRAVE_SEARCH_API_KEY=

# Agent activations one user may run at once across all chats. Defaults to 4.
# Replies and subagents beyond this wait as queued.
# EULER_MAX_RUNNING_AGENTS=4

# Background jobs one chat, and one user across all chats, may run at once.
# Default to 4 and 16.
# EULER_MAX_SESSION_JOBS=4
# EULER_MAX_OWNER_JOBS=16

# Hours until an ephemeral chat, its messages, and its workspace are deleted.
# Defaults to 24.
# EULER_EPHEMERAL_CHAT_TTL_HOURS=24

# Optional Jina Reader API key for higher rate limits.
JINA_API_KEY=

# Local SQLite database and app storage.
# DEPLOYCTL_DATA_DIR is used only when both values below are unset;
# leave them unset under deployctl.
# Keep these local to each worktree during manual development.
EULER_DB_PATH=./data/euler.db
EULER_DATA_ROOT=./data

# Optional OpenRouter API key.
OPENROUTER_API_KEY=

# Serve the built UI from the backend. Defaults to true.
# EULER_SERVE_FRONTEND=true

# The HTTPS address Euler is served at, such as its Tailscale Serve address.
# MCP OAuth sign-in redirects here when Euler is opened at a plain http
# address. A plain http value is ignored unless its host is loopback. Without
# an HTTPS address, the web app needs the callback pasted by hand and the
# iPhone app can't sign in to MCP servers.
# EULER_PUBLIC_URL=https://machine.tailnet.ts.net

# Log verbosity: info, warn, error, or silent. Defaults to info.
LOG_LEVEL=info

# Optional push to the iOS app: an APNs token-auth key (.p8), its key ID and
# the Apple team ID. Push is off unless all three are set.
# APNS_KEY_FILE=
# APNS_KEY_ID=
# APNS_TEAM_ID=
